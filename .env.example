# --- Required ---

# Bootstraps the admin password on first boot only. After the admin panel is
# used once to log in, this value is inert — change the password via the
# admin UI instead of editing this.
ADMIN_PASSWORD=changeme-on-first-boot

# Signs the admin session cookie and derives the key used to encrypt the
# Microsoft Graph client secret at rest. Generate with: openssl rand -hex 32
APP_SECRET=

# Required by Nominatim's (OpenStreetMap geocoder) usage policy — identify
# your app/contact, e.g. "mth-infoscreen (you@example.com)".
NOMINATIM_USER_AGENT=

# --- Optional ---
PORT=3000
NODE_ENV=production
TZ=Europe/Berlin

# Marks the admin session cookie Secure (HTTPS-only). Leave unset/false for
# a plain-HTTP local network deployment (e.g. a Synology NAS on your LAN) —
# browsers silently refuse to store a Secure cookie over plain HTTP, which
# would otherwise permanently break admin login. Only set to true if this
# app sits behind a reverse proxy that terminates HTTPS.
COOKIE_SECURE=false

# Where the persisted config.json lives. Must be a mounted volume in
# production so settings survive redeploys.
CONFIG_DIR=/data

# Escape hatch if the public v6.db.transport.rest instance is ever swapped
# for a self-hosted one.
DEPARTURES_API_BASE=https://v6.db.transport.rest
